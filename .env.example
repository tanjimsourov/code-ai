DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com
TIME_ZONE=UTC

DATABASE_URL=postgres://code_ai:change-me@localhost:5432/code_ai
REDIS_URL=redis://localhost:6379/0

STATIC_ROOT=/var/www/code-ai/static
MEDIA_ROOT=/var/lib/code-ai/media

CODE_EDITOR_PUBLIC_MODEL_LISTING=false
CODE_EDITOR_PUBLIC_METRICS=false
CODE_EDITOR_METRICS_TOKEN=change-me-long-random-token

CODE_EDITOR_TASK_STORAGE_ROOT=/var/lib/code-ai/tasks
CODE_EDITOR_REPOSITORY_STORAGE_ROOT=/var/lib/code-ai/repositories
CODE_EDITOR_ARTIFACT_STORAGE_ROOT=/var/lib/code-ai/artifacts

CODE_EDITOR_COMMAND_TIMEOUT_SECONDS=120
CODE_EDITOR_COMMAND_MAX_OUTPUT_BYTES=1048576

CODE_EDITOR_OLLAMA_ENABLED=false
CODE_EDITOR_OLLAMA_BASE_URL=http://localhost:11434
CODE_EDITOR_OLLAMA_MODEL=qwen2.5-coder:7b

CODE_EDITOR_OPENAI_COMPATIBLE_ENABLED=false
CODE_EDITOR_OPENAI_COMPATIBLE_BASE_URL=
CODE_EDITOR_OPENAI_COMPATIBLE_API_KEY=
CODE_EDITOR_OPENAI_COMPATIBLE_MODEL=

CODE_EDITOR_VLLM_ENABLED=false
CODE_EDITOR_VLLM_BASE_URL=
CODE_EDITOR_VLLM_MODEL=

CODE_EDITOR_LLAMA_CPP_ENABLED=false
CODE_EDITOR_LLAMA_CPP_BASE_URL=
CODE_EDITOR_LLAMA_CPP_MODEL=

CODE_EDITOR_EMBEDDINGS_ENABLED=false
CODE_EDITOR_EMBEDDINGS_PROVIDER=
CODE_EDITOR_RERANK_ENABLED=false

CODE_EDITOR_UPSTREAM_SOURCES=
CODE_EDITOR_UPSTREAM_STATE_FILE=/var/lib/code-ai/upstream-state.json

CODE_EDITOR_THROTTLE_RATE_USER=1000/day
CODE_EDITOR_THROTTLE_RATE_ANON=100/day

CODE_EDITOR_OBSERVABILITY_ENABLED=false

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
