[Unit]
Description=Code Editor Daphne ASGI
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/code-editor
EnvironmentFile=/opt/code-editor/.env
ExecStart=/opt/code-editor/.venv/bin/daphne -b 127.0.0.1 -p 8001 config.asgi:application
Restart=always

[Install]
WantedBy=multi-user.target
